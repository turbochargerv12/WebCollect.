{
  "manifest_version": 3,
  "name": "WebCollect — Collect, Edit, Export",
  "version": "1.0.0",
  "description": "Collect webpage elements, edit them, and export selectable-text PDFs.",
  "permissions": [
    "storage",
    "downloads",
    "debugger",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open WebCollect sidebar"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "collector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "116"
}
